            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/players/me/cards",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardIds\": [9999]\n}"
            }
          }
        },
        {
          "name": "Listar mis cartas desbloqueadas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/players/me/cards"
          }
        },
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/players/me/cards"
          }
        }
      ]
    },
    {
      "name": "2. Cartas — por ID",
      "item": [
