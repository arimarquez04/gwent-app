{
  "info": {
    "name": "Gwent MS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:8080" },
    { "key": "token",            "value": "" },
    { "key": "oponenteId",       "value": "uuid-del-oponente",     "description": "UUID del jugador oponente (extraer del JWT o perfil)" },
    { "key": "mazoId",           "value": "1",                     "description": "ID del mazo ACTIVO propio" },
    { "key": "mazoOponenteId",   "value": "2",                     "description": "ID del mazo ACTIVO del oponente (temporal)" },
    { "key": "partidaId",        "value": "",                      "description": "Auto-guardado al crear partida" },
    { "key": "cartaPartidaId",   "value": "",                      "description": "ID de una CartaPartida en tu mano (auto-guardado al ver partida)" },
    { "key": "reviveCartaId",    "value": "",                      "description": "ID de carta en cementerio para MEDICO" },
    { "key": "targetCartaId",    "value": "",                      "description": "ID de carta en campo para DECOY" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"email\": \"test@example.com\",\n  \"gameId\": \"testgame\",\n  \"tag\": \"1234\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.data && json.data.accessToken) {", "  pm.collectionVariables.set('token', json.data.accessToken);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"testuser\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login (por email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login (por gameId#tag)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"testgame#1234\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login (credenciales incorrectas → 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"testuser\",\n  \"password\": \"wrongpassword\"\n}" }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/password", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "1. Jugadores",
      "item": [
        {
          "name": "Obtener mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/players/me", "host": ["{{baseUrl}}"], "path": ["api","players","me"] }
          }
        },
        {
          "name": "Actualizar mi perfil (apodo)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/players/me", "host": ["{{baseUrl}}"], "path": ["api","players","me"] },
            "body": { "mode": "raw", "raw": "{\n  \"apodo\": \"NuevoApodo\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Cartas — sin filtro",
      "item": [
        {
          "name": "Todas las cartas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"] }
          }
        },
        {
          "name": "Solo líderes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?tipo=LIDER", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "tipo", "value": "LIDER" }] }
          }
        },
        {
          "name": "Líderes por facción (REINO_DEL_NORTE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?tipo=LIDER&faccion=REINO_DEL_NORTE", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "tipo", "value": "LIDER" }, { "key": "faccion", "value": "REINO_DEL_NORTE" }] }
          }
        },
        {
          "name": "Cartas CLIMA",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?tipo=CLIMA", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "tipo", "value": "CLIMA" }] }
          }
        },
        {
          "name": "Cartas ESPECIAL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?tipo=ESPECIAL", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "tipo", "value": "ESPECIAL" }] }
          }
        },
        {
          "name": "Cartas con BERSERKER",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?habilidad=BERSERKER", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "habilidad", "value": "BERSERKER" }] }
          }
        },
        {
          "name": "Cartas con SCORCH",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?habilidad=SCORCH", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "habilidad", "value": "SCORCH" }] }
          }
        },
        {
          "name": "Obtener carta por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards/1", "host": ["{{baseUrl}}"], "path": ["api","v1","cards","1"] }
          }
        },
        {
          "name": "Cartas por fila (CUERPO_A_CUERPO)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?fila=CUERPO_A_CUERPO", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "fila", "value": "CUERPO_A_CUERPO" }] }
          }
        },
        {
          "name": "Solo héroes (?esHeroe=true)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?esHeroe=true", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "esHeroe", "value": "true" }] }
          }
        },
        {
          "name": "Solo cartas CLIMA + ESPECIAL (?esEspecial=true)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cards?esEspecial=true", "host": ["{{baseUrl}}"], "path": ["api","v1","cards"], "query": [{ "key": "esEspecial", "value": "true" }] }
          }
        }
      ]
    },
    {
      "name": "3. Mis cartas (desbloqueo)",
      "item": [
        {
          "name": "Desbloquear cartas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/cards", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","cards"] },
            "body": { "mode": "raw", "raw": "{\n  \"cardIds\": [1, 2, 3]\n}" }
          }
        },
        {
          "name": "Listar mis cartas desbloqueadas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/cards", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","cards"] }
          }
        }
      ]
    },
    {
      "name": "4. Mazos",
      "item": [
        {
          "name": "Crear mazo (sin lider ni cartas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos"] },
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mi mazo RDN\",\n  \"faccion\": \"REINO_DEL_NORTE\"\n}" }
          }
        },
        {
          "name": "Crear mazo (con lider y cartas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos"] },
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mazo RDN con lider\",\n  \"faccion\": \"REINO_DEL_NORTE\",\n  \"liderId\": 1,\n  \"cardEntries\": [\n    { \"cartaCatalogoId\": 5, \"cantidad\": 1 },\n    { \"cartaCatalogoId\": 6, \"cantidad\": 3 },\n    { \"cartaCatalogoId\": 7, \"cantidad\": 3 },\n    { \"cartaCatalogoId\": 8, \"cantidad\": 3 }\n  ]\n}" }
          }
        },
        {
          "name": "Listar mis mazos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos"] }
          }
        },
        {
          "name": "Obtener mazo por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}"] }
          }
        },
        {
          "name": "Editar mazo (cambiar lider)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"liderId\": 2\n}" }
          }
        },
        {
          "name": "Editar mazo: quitar líder (liderId: -1)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"liderId\": -1\n}" }
          }
        },
        {
          "name": "Activar mazo con < 22 unidades → 422",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}/activate", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}","activate"] }
          }
        },
        {
          "name": "Crear 4° mazo de la misma facción → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos"] },
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mazo extra RDN\",\n  \"faccion\": \"REINO_DEL_NORTE\"\n}" }
          }
        },
        {
          "name": "Activar mazo",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}/activate", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}","activate"] }
          }
        },
        {
          "name": "Eliminar mazo → 204",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/players/me/mazos/{{mazoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","players","me","mazos","{{mazoId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Partidas — Paso a paso",
      "description": "Flujo completo de una partida. Variables necesarias antes de empezar:\n- {{token}}: JWT del jugador activo (ejecutar Login)\n- {{oponenteId}}: UUID del oponente\n- {{mazoId}}: ID del mazo ACTIVO propio\n- {{mazoOponenteId}}: ID del mazo ACTIVO del oponente\n\nEl resto de variables (partidaId, cartaPartidaId, etc.) se autocompletan con los scripts de test.",
      "item": [
        {
          "name": "PASO 1 — Crear partida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('partidaId', json.data.id.toString());",
                  "  console.log('partidaId guardado:', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oponenteId\": \"{{oponenteId}}\",\n  \"mazoId\": {{mazoId}},\n  \"mazoOponenteId\": {{mazoOponenteId}}\n}"
            }
          }
        },
        {
          "name": "PASO 2 — Ver estado (MULLIGAN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.yo && json.data.yo.mano && json.data.yo.mano.length > 0) {",
                  "  pm.collectionVariables.set('cartaPartidaId', json.data.yo.mano[0].id.toString());",
                  "  console.log('cartaPartidaId (primera carta en mano):', json.data.yo.mano[0].id);",
                  "  console.log('Lider:', JSON.stringify(json.data.yo.lider));",
                  "  console.log('Estado:', json.data.estado);",
                  "}",
                  "if (json.data && json.data.yo && json.data.yo.cementerio && json.data.yo.cementerio.length > 0) {",
                  "  pm.collectionVariables.set('reviveCartaId', json.data.yo.cementerio[0].id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}"] }
          }
        },
        {
          "name": "PASO 3a — Mulligan: jugador activo (skip, 0 cambios)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}/mulligan", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}","mulligan"] },
            "body": { "mode": "raw", "raw": "{\n  \"cartaPartidaIds\": []\n}" }
          }
        },
        {
          "name": "PASO 3b — Mulligan: jugador activo (intercambiar 1 carta)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}/mulligan", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}","mulligan"] },
            "body": { "mode": "raw", "raw": "{\n  \"cartaPartidaIds\": [{{cartaPartidaId}}]\n}" }
          }
        },
        {
          "name": "PASO 3c — Mulligan: intercambiar 2 cartas (reemplazar IDs manualmente)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}/mulligan", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}","mulligan"] },
            "body": { "mode": "raw", "raw": "{\n  \"cartaPartidaIds\": [{{cartaPartidaId}}, 0]\n}" }
          }
        },
        {
          "name": "PASO 4 — Ver estado (EN_CURSO) — actualiza {{cartaPartidaId}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  console.log('Estado:', json.data.estado);",
                  "  console.log('EsMiTurno:', json.data.esMiTurno);",
                  "  console.log('Lider:', JSON.stringify(json.data.yo.lider));",
                  "  console.log('LiderUsado:', json.data.yo.liderUsado);",
                  "  console.log('Clima en campo:', JSON.stringify(json.data.climaEnCampo));",
                  "  if (json.data.yo.mano && json.data.yo.mano.length > 0) {",
                  "    pm.collectionVariables.set('cartaPartidaId', json.data.yo.mano[0].id.toString());",
                  "    console.log('cartaPartidaId actualizado:', json.data.yo.mano[0].id, '| tipo:', json.data.yo.mano[0].tipo, '| habilidad:', json.data.yo.mano[0].habilidad);",
                  "  }",
                  "  if (json.data.yo.cementerio && json.data.yo.cementerio.length > 0) {",
                  "    pm.collectionVariables.set('reviveCartaId', json.data.yo.cementerio[0].id.toString());",
                  "    console.log('reviveCartaId actualizado:', json.data.yo.cementerio[0].id);",
                  "  }",
                  "  if (json.data.yo.tablero) {",
                  "    var t = json.data.yo.tablero;",
                  "    if (t.cuerpoACuerpo && t.cuerpoACuerpo.length > 0) {",
                  "      pm.collectionVariables.set('targetCartaId', t.cuerpoACuerpo[0].id.toString());",
                  "      console.log('targetCartaId (primera carta en CAC):', t.cuerpoACuerpo[0].id);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}"] }
          }
        },
        {
          "name": "PASO 5a — Jugar carta UNIDAD (fila del catálogo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/partidas/{{partidaId}}/jugar-carta", "host": ["{{baseUrl}}"], "path": ["api","v1","partidas","{{partidaId}}","jugar-carta"] },
            "body": { "mode": "raw", "raw": "{\n  \"cartaPartidaId\": {{cartaPartidaId}}\n}" }
          }
        },
        {
          "name": "PASO 5b — Jugar carta AGIL (requiere fila manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
