            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=SKELLIGE&fila=CUERPO_A_CUERPO&esHeroe=false",
