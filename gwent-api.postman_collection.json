{
  "info": {
    "name": "Gwent MS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"email\": \"test@example.com\",\n  \"gameId\": \"testgame\",\n  \"tag\": \"1234\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"testuser\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (por email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (por gameId#tag)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"testgame#1234\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (credenciales incorrectas → 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"testuser\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword456\"\n}"
            }
          }
        },
        {
          "name": "Cambiar contraseña (password incorrecta → 401)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"wrong\",\n  \"newPassword\": \"newpassword456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "1. Jugadores",
      "item": [
        {
          "name": "Obtener mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/players/me"
          }
        },
        {
          "name": "Actualizar mi perfil (apodo)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/players/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apodo\": \"NuevoApodo\"\n}"
            }
          }
        },
        {
          "name": "Actualizar mi perfil (avatarUrl)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/players/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}"
            }
          }
        },
        {
          "name": "Actualizar mi perfil (ambos campos)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/players/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apodo\": \"OtroApodo\",\n  \"avatarUrl\": \"https://example.com/avatar2.png\"\n}"
            }
          }
        },
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/players/me"
          }
        }
      ]
    },
    {
      "name": "2. Cartas — sin filtro",
      "item": [
        {
          "name": "Todas las cartas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/cards"
          }
        },
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/cards"
          }
        }
      ]
    },
    {
      "name": "2. Cartas — por facción",
      "item": [
        {
          "name": "REINO_DEL_NORTE",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=REINO_DEL_NORTE",
              "query": [{ "key": "faccion", "value": "REINO_DEL_NORTE" }]
            }
          }
        },
        {
          "name": "NILFGAARD",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=NILFGAARD",
              "query": [{ "key": "faccion", "value": "NILFGAARD" }]
            }
          }
        },
        {
          "name": "MONSTRUOS",
          "request": {
