    },
    {
      "name": "2. Cartas — por tipo",
      "item": [
        {
          "name": "UNIDAD",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?tipo=UNIDAD",
