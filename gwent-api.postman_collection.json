            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}"
            }
          }
        },
        {
          "name": "Actualizar mi perfil (ambos campos)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/players/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players", "me"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apodo\": \"OtroApodo\",\n  \"avatarUrl\": \"https://example.com/avatar2.png\"\n}"
            }
          }
        },
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "players", "me"]
            }
          }
        }
