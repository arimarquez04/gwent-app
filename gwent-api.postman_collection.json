    {
      "name": "2. Cartas — filtros combinados",
      "item": [
        {
          "name": "RDN + CaC",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=REINO_DEL_NORTE&fila=CUERPO_A_CUERPO",
              "query": [
                { "key": "faccion", "value": "REINO_DEL_NORTE" },
                { "key": "fila",    "value": "CUERPO_A_CUERPO" }
              ]
            }
          }
        },
        {
          "name": "NILFGAARD + no héroes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=NILFGAARD&esHeroe=false",
              "query": [
                { "key": "faccion",  "value": "NILFGAARD" },
                { "key": "esHeroe", "value": "false" }
              ]
            }
          }
        },
