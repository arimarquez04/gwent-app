            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=MONSTRUOS",
              "query": [{ "key": "faccion", "value": "MONSTRUOS" }]
            }
          }
        },
        {
          "name": "SCOIA_TAEL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=SCOIA_TAEL",
              "query": [{ "key": "faccion", "value": "SCOIA_TAEL" }]
            }
          }
        },
        {
          "name": "SKELLIGE",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=SKELLIGE",
              "query": [{ "key": "faccion", "value": "SKELLIGE" }]
            }
          }
        },
        {
          "name": "NEUTRAL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=NEUTRAL",
              "query": [{ "key": "faccion", "value": "NEUTRAL" }]
            }
          }
        },
        {
          "name": "Facción inválida → 400",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?faccion=INVALIDA",
              "query": [{ "key": "faccion", "value": "INVALIDA" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Cartas — por fila",
      "item": [
        {
          "name": "CUERPO_A_CUERPO",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cards?fila=CUERPO_A_CUERPO",
